rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Latest sensor snapshot (written by IoT device via REST API)
    match /sensors/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Timestamped historical readings
    match /sensor_history/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Relay state (web app writes; IoT device reads)
    match /relays/{relayId} {
      allow read, write: if isSignedIn();
    }

    // Alert configuration and active alerts
    match /alerts/{docId} {
      allow read, write: if isSignedIn();
    }

    // System & threshold settings
    match /settings/{docId} {
      allow read, write: if isSignedIn();
    }

    // Microalgae cultures (culture/batch management)
    match /algae_cultures/{docId} {
      allow read, write: if isSignedIn();
    }

    // Energy optimization config & automatic backup state
    // (web writes; IoT device may read backup_state to switch source)
    match /energy/{docId} {
      allow read, write: if isSignedIn();
    }

    // Per-user profile data
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
